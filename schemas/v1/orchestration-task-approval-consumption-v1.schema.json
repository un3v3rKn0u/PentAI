{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-task-approval-consumption-v1.schema.json",
  "title": "PentAI OrchestrationTaskApprovalConsumption v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "consumption_id", "request_id", "request_digest", "decision_id", "decision_digest", "assessment_id", "plan_id", "expected_plan_revision", "resulting_plan_revision", "task_id", "expected_task_revision", "resulting_task_revision", "task_type", "policy_bundle_id", "policy_hash", "purpose", "requested_capability", "parameters_digest", "human_actor", "authentication_context", "approval_expires_at", "consumed_at", "resulting_task_state", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "consumption_id": {"type": "string", "format": "uuid"},
    "request_id": {"type": "string", "format": "uuid"},
    "request_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "decision_id": {"type": "string", "format": "uuid"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "expected_plan_revision": {"type": "integer", "minimum": 1},
    "resulting_plan_revision": {"type": "integer", "minimum": 2},
    "task_id": {"type": "string", "format": "uuid"},
    "expected_task_revision": {"type": "integer", "minimum": 1},
    "resulting_task_revision": {"type": "integer", "minimum": 2},
    "task_type": {"enum": ["scope", "rules_of_engagement", "evidence", "validation", "reporting"]},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "purpose": {"const": "authorize_task_readiness"},
    "requested_capability": {"const": "orchestration.task.ready"},
    "parameters_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "human_actor": {"type": "object", "additionalProperties": false, "required": ["actor_type", "actor_id", "session_id"], "properties": {"actor_type": {"const": "human"}, "actor_id": {"type": "string", "minLength": 1, "maxLength": 128}, "session_id": {"type": "string", "format": "uuid"}}},
    "authentication_context": {"const": "local_core_authenticated_session"},
    "approval_expires_at": {"type": "string", "format": "date-time"},
    "consumed_at": {"type": "string", "format": "date-time"},
    "resulting_task_state": {"const": "ready"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
