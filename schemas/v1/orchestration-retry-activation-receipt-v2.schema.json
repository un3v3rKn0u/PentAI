{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-retry-activation-receipt-v2.schema.json",
  "title": "PentAI OrchestrationRetryActivationReceipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "activation_id", "command_id", "command_digest", "assessment_id", "plan_id", "expected_plan_revision", "resulting_plan_revision", "resulting_plan_state", "task_id", "expected_task_revision", "resulting_task_revision", "schedule_id", "schedule_digest", "attempt_id", "attempt_digest", "attempt_number", "retry_budget_consumption_id", "eligibility_decision_id", "policy_bundle_id", "policy_hash", "retry_policy_id", "retry_policy_digest", "recovery_generation", "scheduled_for", "schedule_expires_at", "purpose", "resulting_task_state", "activated_at", "activation_digest", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "activation_id": {"type": "string", "format": "uuid"},
    "command_id": {"type": "string", "format": "uuid"},
    "command_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "expected_plan_revision": {"type": "integer", "minimum": 5},
    "resulting_plan_revision": {"type": "integer", "minimum": 6},
    "resulting_plan_state": {"const": "active"},
    "task_id": {"type": "string", "format": "uuid"},
    "expected_task_revision": {"type": "integer", "minimum": 5},
    "resulting_task_revision": {"type": "integer", "minimum": 6},
    "schedule_id": {"type": "string", "format": "uuid"},
    "schedule_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "attempt_id": {"type": "string", "format": "uuid"},
    "attempt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "attempt_number": {"const": 3},
    "retry_budget_consumption_id": {"type": "string", "format": "uuid"},
    "eligibility_decision_id": {"type": "string", "format": "uuid"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retry_policy_id": {"type": "string", "format": "uuid"},
    "retry_policy_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "recovery_generation": {"type": "integer", "minimum": 1},
    "scheduled_for": {"type": "string", "format": "date-time"},
    "schedule_expires_at": {"type": "string", "format": "date-time"},
    "purpose": {"const": "activate_validation_retry_readiness_three"},
    "resulting_task_state": {"const": "ready"},
    "activated_at": {"type": "string", "format": "date-time"},
    "activation_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
