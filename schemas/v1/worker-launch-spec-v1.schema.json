{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/worker-launch-spec-v1.schema.json",
  "title": "PentAI WorkerLaunchSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "launch_id", "session_id", "containment_attestation_id", "image_digest", "argv", "network_mode", "gateway_network_id", "read_only_root", "drop_capabilities", "no_new_privileges", "pid_limit", "memory_bytes", "cpu_quota", "temporary_workspace", "mount_runtime_socket", "host_pid", "host_ipc", "ipv6_enabled", "external_dns_enabled", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "launch_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "containment_attestation_id": {"type": "string", "format": "uuid"},
    "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "network_mode": {"const": "gateway_only"},
    "gateway_network_id": {"type": "string", "minLength": 1},
    "read_only_root": {"const": true},
    "drop_capabilities": {"const": "ALL"},
    "no_new_privileges": {"const": true},
    "pid_limit": {"type": "integer", "minimum": 1, "maximum": 1024},
    "memory_bytes": {"type": "integer", "minimum": 16777216, "maximum": 4294967296},
    "cpu_quota": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
    "temporary_workspace": {"const": true},
    "mount_runtime_socket": {"const": false},
    "host_pid": {"const": false},
    "host_ipc": {"const": false},
    "ipv6_enabled": {"const": false},
    "external_dns_enabled": {"const": false},
    "execution_enabled": {"const": false}
  }
}
