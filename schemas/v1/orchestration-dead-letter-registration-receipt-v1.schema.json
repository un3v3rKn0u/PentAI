{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-dead-letter-registration-receipt-v1.schema.json",
  "title": "PentAI OrchestrationDeadLetterRegistrationReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registration_id", "command_id", "command_digest", "assessment_id", "plan_id", "plan_revision", "task_id", "task_revision", "task_state", "terminal_consumption_id", "terminal_consumption_digest", "terminal_decision_id", "terminal_decision_digest", "attempt_number", "maximum_attempts", "outcome", "reason_code", "registration_state", "retention_mode", "delivery_enabled", "claim_enabled", "acknowledgement_enabled", "retry_enabled", "deletion_enabled", "cleanup_enabled", "operator_review_enabled", "purpose", "registered_at", "receipt_digest", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registration_id": {"type": "string", "format": "uuid"},
    "command_id": {"type": "string", "format": "uuid"},
    "command_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "plan_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "task_id": {"type": "string", "format": "uuid"},
    "task_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "task_state": {"const": "dead_letter"},
    "terminal_consumption_id": {"type": "string", "format": "uuid"},
    "terminal_consumption_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "terminal_decision_id": {"type": "string", "format": "uuid"},
    "terminal_decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "attempt_number": {"const": 3},
    "maximum_attempts": {"const": 3},
    "outcome": {"const": "dead_letter_registered"},
    "reason_code": {"const": "retry_ceiling_exhausted"},
    "registration_state": {"const": "registered"},
    "retention_mode": {"const": "immutable_history"},
    "delivery_enabled": {"const": false},
    "claim_enabled": {"const": false},
    "acknowledgement_enabled": {"const": false},
    "retry_enabled": {"const": false},
    "deletion_enabled": {"const": false},
    "cleanup_enabled": {"const": false},
    "operator_review_enabled": {"const": false},
    "purpose": {"const": "register_attempt_three_dead_letter"},
    "registered_at": {"type": "string", "format": "date-time"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
