{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/ai-provider-configuration-v1.schema.json",
  "title": "PentAI AI Provider Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "configuration_id",
    "provider_type",
    "provider_id",
    "model_id",
    "secret_ref",
    "privacy_classification",
    "allowed_input_classifications",
    "budgets",
    "remote_provider_opt_in",
    "configured_at",
    "expires_at",
    "execution_enabled"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "configuration_id": {"type": "string", "format": "uuid"},
    "provider_type": {"enum": ["approved_remote", "local_runtime"]},
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "secret_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^secretref://provider/[a-z0-9][a-z0-9.-]{0,63}/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {"type": "null"}
      ]
    },
    "privacy_classification": {
      "enum": ["remote_third_party", "local_device"]
    },
    "allowed_input_classifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted_redacted",
          "restricted_raw_evidence",
          "secret"
        ]
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_tokens",
        "max_output_tokens",
        "max_requests",
        "max_cost_microusd",
        "max_runtime_seconds"
      ],
      "properties": {
        "max_input_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_requests": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_cost_microusd": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "remote_provider_opt_in": {"type": "boolean"},
    "configured_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "execution_enabled": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"provider_type": {"const": "approved_remote"}}},
      "then": {
        "properties": {
          "secret_ref": {"type": "string"},
          "privacy_classification": {"const": "remote_third_party"},
          "remote_provider_opt_in": {"const": true}
        }
      },
      "else": {
        "properties": {
          "secret_ref": {"const": null},
          "privacy_classification": {"const": "local_device"},
          "remote_provider_opt_in": {"const": false},
          "budgets": {
            "properties": {"max_cost_microusd": {"const": 0}}
          }
        }
      }
    }
  ]
}
