{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-task-attempt-receipt-v2.schema.json",
  "title": "PentAI OrchestrationTaskAttemptReceipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "command_id", "command_digest", "assessment_id", "plan_id", "plan_revision", "task_id", "task_revision", "agent_id", "capability_manifest_id", "capability_manifest_digest", "manifest_revision", "budget_reservation_id", "budget_request_digest", "budget_account_version", "retry_activation_id", "retry_activation_digest", "retry_attempt_digest", "retry_budget_consumption_id", "approval_consumption_id", "lease_consumption_id", "lease_consumption_digest", "policy_bundle_id", "policy_hash", "worker_id", "worker_version", "lease_generation", "fencing_token", "recovery_generation", "checkpoint_id", "checkpoint_sequence", "checkpoint_digest", "failure_id", "failure_receipt_digest", "failure_class", "attempt_number", "attempt_state", "purpose", "registered_at", "attempt_digest", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "attempt_id": {"type": "string", "format": "uuid"},
    "command_id": {"type": "string", "format": "uuid"},
    "command_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "plan_revision": {"type": "integer", "minimum": 5},
    "task_id": {"type": "string", "format": "uuid"},
    "task_revision": {"type": "integer", "minimum": 5},
    "agent_id": {"type": "string"},
    "capability_manifest_id": {"type": "string", "format": "uuid"},
    "capability_manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "manifest_revision": {"const": 1},
    "budget_reservation_id": {"type": "string", "format": "uuid"},
    "budget_request_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "budget_account_version": {"type": "integer", "minimum": 3},
    "retry_activation_id": {"type": "string", "format": "uuid"},
    "retry_activation_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "retry_attempt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "retry_budget_consumption_id": {"type": "string", "format": "uuid"},
    "approval_consumption_id": {"type": ["string", "null"], "format": "uuid"},
    "lease_consumption_id": {"type": "string", "format": "uuid"},
    "lease_consumption_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "worker_id": {"type": "string"},
    "worker_version": {"type": "integer", "minimum": 1},
    "lease_generation": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "recovery_generation": {"type": "integer", "minimum": 1},
    "checkpoint_id": {"type": ["string", "null"], "format": "uuid"},
    "checkpoint_sequence": {"type": ["integer", "null"], "minimum": 1, "maximum": 10000},
    "checkpoint_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "failure_id": {"type": "string", "format": "uuid"},
    "failure_receipt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "failure_class": {"enum": ["checkpoint_stalled", "coordination_timeout", "runtime_unavailable", "worker_process_failed"]},
    "attempt_number": {"const": 2},
    "attempt_state": {"const": "failed"},
    "purpose": {"const": "register_failed_retry_validation_attempt"},
    "registered_at": {"type": "string", "format": "date-time"},
    "attempt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
