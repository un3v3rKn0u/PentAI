{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-task-budget-reservation-v4.schema.json",
  "title": "PentAI OrchestrationTaskBudgetReservation v4",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "reservation_id", "request_id", "request_digest", "account_id", "account_version", "assessment_id", "plan_id", "plan_revision", "task_id", "task_revision", "task_state", "agent_id", "capability_manifest_id", "capability_manifest_digest", "manifest_revision", "retry_policy_id", "retry_policy_digest", "retry_activation_id", "retry_activation_digest", "retry_schedule_id", "retry_schedule_digest", "retry_attempt_id", "retry_attempt_digest", "attempt_number", "prior_retry_budget_consumption_id", "retry_budget_consumption_id", "approval_consumption_id", "worker_id", "worker_version", "lease_generation", "fencing_token", "recovery_generation", "policy_bundle_id", "policy_hash", "purpose", "amounts", "state", "created_at", "expires_at", "released_at", "release_reason", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "4.0.0"},
    "reservation_id": {"type": "string", "format": "uuid"}, "request_id": {"type": "string", "format": "uuid"},
    "request_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "account_id": {"type": "string", "format": "uuid"}, "account_version": {"type": "integer", "minimum": 2},
    "assessment_id": {"type": "string", "format": "uuid"}, "plan_id": {"type": "string", "format": "uuid"},
    "plan_revision": {"type": "integer", "minimum": 6}, "task_id": {"type": "string", "format": "uuid"},
    "task_revision": {"type": "integer", "minimum": 6}, "task_state": {"const": "ready"},
    "agent_id": {"type": "string", "pattern": "^agent://validation/[a-z0-9][a-z0-9._-]{0,63}$"},
    "capability_manifest_id": {"type": "string", "format": "uuid"}, "capability_manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "manifest_revision": {"const": 1}, "retry_policy_id": {"type": "string", "format": "uuid"},
    "retry_policy_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "retry_activation_id": {"type": "string", "format": "uuid"}, "retry_activation_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "retry_schedule_id": {"type": "string", "format": "uuid"}, "retry_schedule_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "retry_attempt_id": {"type": "string", "format": "uuid"}, "retry_attempt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "attempt_number": {"const": 3}, "prior_retry_budget_consumption_id": {"type": "string", "format": "uuid"},
    "retry_budget_consumption_id": {"type": "string", "format": "uuid"}, "approval_consumption_id": {"type": ["string", "null"], "format": "uuid"},
    "worker_id": {"type": "string", "minLength": 1, "maxLength": 128}, "worker_version": {"type": "integer", "minimum": 1},
    "lease_generation": {"type": "integer", "minimum": 1}, "fencing_token": {"type": "integer", "minimum": 1},
    "recovery_generation": {"type": "integer", "minimum": 1}, "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "purpose": {"const": "reserve_attempt_three_validation_task_budget"},
    "amounts": {"$ref": "#/$defs/amounts"}, "state": {"enum": ["reserved", "released"]},
    "created_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
    "released_at": {"type": ["string", "null"], "format": "date-time"}, "release_reason": {"enum": ["none", "cancelled", "expired", "recovery"]},
    "authority": {"const": "none"}, "execution_enabled": {"const": false}
  },
  "allOf": [{"if": {"properties": {"state": {"const": "reserved"}}}, "then": {"properties": {"released_at": {"const": null}, "release_reason": {"const": "none"}}}, "else": {"properties": {"released_at": {"type": "string", "format": "date-time"}, "release_reason": {"enum": ["cancelled", "expired", "recovery"]}}}}],
  "$defs": {"amounts": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "requests", "cost_microusd", "runtime_seconds", "retries"], "properties": {
    "input_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000}, "output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "requests": {"type": "integer", "minimum": 0, "maximum": 10000}, "cost_microusd": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "runtime_seconds": {"type": "integer", "minimum": 0, "maximum": 86400}, "retries": {"const": 0}
  }}}
}
