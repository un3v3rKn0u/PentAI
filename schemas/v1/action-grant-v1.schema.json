{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/action-grant-v1.schema.json",
  "title": "PentAI ActionGrant v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_id", "intent_id", "decision_id", "assessment_id", "policy_hash", "revocation_epoch", "audience", "capability", "target_digest", "parameters_digest", "constraints", "issued_at", "not_before", "expires_at", "nonce", "single_use", "signature"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "grant_id": {"type": "string", "format": "uuid"},
    "intent_id": {"type": "string", "format": "uuid"},
    "decision_id": {"type": "string", "format": "uuid"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revocation_epoch": {"type": "integer", "minimum": 0},
    "audience": {"enum": ["pentai-execution-broker", "pentai-egress-gateway"]},
    "capability": {"enum": ["network.http.get", "network.http.head", "network.http.options"]},
    "target_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parameters_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_connections", "maximum_requests", "timeout_seconds", "maximum_response_bytes", "follow_redirects", "maximum_redirects"],
      "properties": {
        "maximum_connections": {"type": "integer", "minimum": 1, "maximum": 1},
        "maximum_requests": {"type": "integer", "minimum": 1, "maximum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "maximum_response_bytes": {"type": "integer", "minimum": 1},
        "follow_redirects": {"type": "boolean"},
        "maximum_redirects": {"type": "integer", "minimum": 0, "maximum": 10},
        "required_route_profile_id": {"type": "string"},
        "required_source_ip": {"type": "string"}
      }
    },
    "approval_id": {"type": "string", "format": "uuid"},
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 32},
    "single_use": {"const": true},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
