{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/ai-runtime-meter-identity-receipt-v2.schema.json",
  "title": "PentAI AI Runtime Meter Identity Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meter_id", "meter_identity_digest", "command_id", "command_digest", "implementation_id", "implementation_version", "configuration_snapshot_id", "configuration_snapshot_digest", "configuration_id", "configuration_hash", "registry_id", "registry_revision", "provider_type", "provider_id", "model_id", "worker_id", "worker_version", "runtime_instance_id", "containment_attestation_id", "image_digest", "supported_dimensions", "identity_valid_from", "identity_expires_at", "requester", "authentication_context", "state", "attestation_enabled", "measurement_enabled", "production_enabled", "recorded_at", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "meter_id": {"type": "string", "format": "uuid"},
    "meter_identity_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "command_id": {"type": "string", "format": "uuid"},
    "command_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "implementation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "implementation_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "configuration_snapshot_id": {"type": "string", "format": "uuid"},
    "configuration_snapshot_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "configuration_id": {"type": "string", "format": "uuid"},
    "configuration_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "registry_id": {"type": "string", "format": "uuid"},
    "registry_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "provider_type": {"enum": ["approved_remote", "local_runtime"]},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"},
    "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "worker_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "worker_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "runtime_instance_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "containment_attestation_id": {"type": "string", "format": "uuid"},
    "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "supported_dimensions": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["input_tokens", "output_tokens", "requests", "cost_microusd", "runtime_seconds"]}},
    "identity_valid_from": {"type": "string", "format": "date-time"},
    "identity_expires_at": {"type": "string", "format": "date-time"},
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "actor_id", "session_id"],
      "properties": {
        "actor_type": {"const": "human"},
        "actor_id": {"enum": ["local-desktop-session", "test-session"]},
        "session_id": {"type": "string", "format": "uuid"}
      }
    },
    "authentication_context": {"const": "local_core_authenticated_session"},
    "state": {"const": "inactive"},
    "attestation_enabled": {"const": false},
    "measurement_enabled": {"const": false},
    "production_enabled": {"const": false},
    "recorded_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
