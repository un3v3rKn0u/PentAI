{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-retry-budget-consumption-receipt-v1.schema.json",
  "title": "PentAI OrchestrationRetryBudgetConsumptionReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "consumption_id", "command_id", "command_digest", "assessment_id", "plan_id", "plan_revision", "task_id", "task_revision", "attempt_id", "attempt_digest", "failure_id", "failure_receipt_digest", "checkpoint_id", "checkpoint_digest", "lease_consumption_id", "worker_id", "worker_version", "lease_generation", "fencing_token", "recovery_generation", "capability_manifest_id", "manifest_revision", "budget_account_id", "budget_reservation_id", "budget_reservation_account_version", "budget_account_version_before", "budget_account_version_after", "reserved_retry_units", "consumed_retry_units", "remaining_retry_units", "approval_consumption_id", "policy_bundle_id", "policy_hash", "retry_policy_id", "retry_policy_revision", "retry_policy_digest", "eligibility_decision_id", "eligibility_decision_digest", "proposed_attempt_number", "purpose", "consumed_at", "receipt_digest", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "consumption_id": {"type": "string", "format": "uuid"},
    "command_id": {"type": "string", "format": "uuid"},
    "command_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "plan_revision": {"type": "integer", "minimum": 3},
    "task_id": {"type": "string", "format": "uuid"},
    "task_revision": {"type": "integer", "minimum": 3},
    "attempt_id": {"type": "string", "format": "uuid"},
    "attempt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "failure_id": {"type": "string", "format": "uuid"},
    "failure_receipt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "checkpoint_id": {"type": ["string", "null"], "format": "uuid"},
    "checkpoint_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "lease_consumption_id": {"type": "string", "format": "uuid"},
    "worker_id": {"type": "string"},
    "worker_version": {"type": "integer", "minimum": 1},
    "lease_generation": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "recovery_generation": {"type": "integer", "minimum": 1},
    "capability_manifest_id": {"type": "string", "format": "uuid"},
    "manifest_revision": {"const": 1},
    "budget_account_id": {"type": "string", "format": "uuid"},
    "budget_reservation_id": {"type": "string", "format": "uuid"},
    "budget_reservation_account_version": {"type": "integer", "minimum": 2},
    "budget_account_version_before": {"type": "integer", "minimum": 2},
    "budget_account_version_after": {"type": "integer", "minimum": 3},
    "reserved_retry_units": {"type": "integer", "minimum": 1, "maximum": 100},
    "consumed_retry_units": {"const": 1},
    "remaining_retry_units": {"type": "integer", "minimum": 0, "maximum": 99},
    "approval_consumption_id": {"type": ["string", "null"], "format": "uuid"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retry_policy_id": {"type": "string", "format": "uuid"},
    "retry_policy_revision": {"const": 1},
    "retry_policy_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "eligibility_decision_id": {"type": "string", "format": "uuid"},
    "eligibility_decision_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "proposed_attempt_number": {"const": 2},
    "purpose": {"const": "consume_validation_retry_budget"},
    "consumed_at": {"type": "string", "format": "date-time"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
