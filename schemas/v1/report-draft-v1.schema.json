{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/report-draft-v1.schema.json",
  "title": "PentAI Report Draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "workflow_id", "engagement_id", "policy_bundle_id", "status", "classification", "template", "title", "finding_refs", "artifacts", "created_by", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "format": "uuid"},
    "workflow_id": {"type": "string", "format": "uuid"},
    "engagement_id": {"type": "string", "format": "uuid"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "status": {"const": "draft"},
    "classification": {"const": "restricted"},
    "template": {"enum": ["generic", "hackerone", "bugcrowd", "intigriti"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "finding_refs": {
      "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["finding_id", "version", "content_hash"],
        "properties": {
          "finding_id": {"type": "string", "format": "uuid"},
          "version": {"type": "integer", "minimum": 1},
          "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["format", "media_type", "sha256", "size_bytes"],
        "properties": {
          "format": {"enum": ["markdown", "html", "json", "pdf"]},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 100},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152}
        }
      }
    },
    "created_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
