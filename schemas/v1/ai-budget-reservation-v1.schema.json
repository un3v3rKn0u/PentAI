{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/ai-budget-reservation-v1.schema.json",
  "title": "PentAI AI Budget Reservation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reservation_id", "configuration_id", "registry_id", "registry_revision", "idempotency_key", "request_fingerprint", "ledger_version", "state", "amounts", "created_at", "expires_at", "finalized_at", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "reservation_id": {"type": "string", "format": "uuid"},
    "configuration_id": {"type": "string", "format": "uuid"},
    "registry_id": {"type": "string", "format": "uuid"},
    "registry_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{15,127}$"},
    "request_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ledger_version": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "state": {"enum": ["reserved", "committed", "released"]},
    "amounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "requests", "cost_microusd", "runtime_seconds"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "requests": {"type": "integer", "minimum": 0, "maximum": 10000},
        "cost_microusd": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "runtime_seconds": {"type": "integer", "minimum": 0, "maximum": 86400}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "finalized_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "execution_enabled": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "reserved"}}},
      "then": {"properties": {"finalized_at": {"const": null}}},
      "else": {"properties": {"finalized_at": {"type": "string", "format": "date-time"}}}
    }
  ]
}
