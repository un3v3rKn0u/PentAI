{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-retry-attempt-command-v2.schema.json",
  "title": "PentAI OrchestrationRetryAttemptCommand v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "assessment_id", "plan_id", "expected_plan_revision", "task_id", "expected_task_revision", "prior_attempt_id", "prior_attempt_digest", "retry_budget_consumption_id", "retry_budget_consumption_digest", "attempt_number", "purpose", "requested_at", "expires_at", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "command_id": {"type": "string", "format": "uuid"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "expected_plan_revision": {"type": "integer", "minimum": 5},
    "task_id": {"type": "string", "format": "uuid"},
    "expected_task_revision": {"type": "integer", "minimum": 5},
    "prior_attempt_id": {"type": "string", "format": "uuid"},
    "prior_attempt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "retry_budget_consumption_id": {"type": "string", "format": "uuid"},
    "retry_budget_consumption_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "attempt_number": {"const": 3},
    "purpose": {"const": "register_validation_retry_attempt_three"},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
