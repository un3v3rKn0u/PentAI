{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/ai-provider-registry-activation-receipt-v1.schema.json",
  "title": "PentAI AI Provider Registry Activation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "activation_id", "command_id", "command_digest", "snapshot_id", "snapshot_digest", "snapshot_receipt_digest", "registry_id", "registry_revision", "registry_digest", "providers_digest", "requester", "authentication_context", "state", "configuration_snapshot_enabled", "revocation_enabled", "activated_at", "expires_at", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "activation_id": {"type": "string", "format": "uuid"},
    "command_id": {"type": "string", "format": "uuid"},
    "command_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "snapshot_id": {"type": "string", "format": "uuid"},
    "snapshot_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "snapshot_receipt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "registry_id": {"type": "string", "format": "uuid"},
    "registry_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "registry_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "providers_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "actor_id", "session_id"],
      "properties": {
        "actor_type": {"const": "human"},
        "actor_id": {"enum": ["local-desktop-session", "test-session"]},
        "session_id": {"type": "string", "format": "uuid"}
      }
    },
    "authentication_context": {"const": "local_core_authenticated_session"},
    "state": {"const": "active"},
    "configuration_snapshot_enabled": {"const": false},
    "revocation_enabled": {"const": false},
    "activated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
