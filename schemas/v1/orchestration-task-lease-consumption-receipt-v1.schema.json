{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-task-lease-consumption-receipt-v1.schema.json",
  "title": "PentAI OrchestrationTaskLeaseConsumptionReceipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "consumption_id", "command_id", "command_digest", "assessment_id", "plan_id", "expected_plan_revision", "resulting_plan_revision", "task_id", "expected_task_revision", "resulting_task_revision", "agent_id", "capability_manifest_id", "manifest_revision", "budget_reservation_id", "budget_account_version", "approval_consumption_id", "policy_bundle_id", "policy_hash", "worker_id", "worker_version", "lease_id", "consumed_lease_version", "resulting_lease_version", "lease_generation", "fencing_token", "recovery_generation", "lease_state_digest", "purpose", "consumed_at", "resulting_task_state", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "consumption_id": {"type": "string", "format": "uuid"},
    "command_id": {"type": "string", "format": "uuid"},
    "command_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "expected_plan_revision": {"type": "integer", "minimum": 1},
    "resulting_plan_revision": {"type": "integer", "minimum": 2},
    "task_id": {"type": "string", "format": "uuid"},
    "expected_task_revision": {"type": "integer", "minimum": 1},
    "resulting_task_revision": {"type": "integer", "minimum": 2},
    "agent_id": {"type": "string"},
    "capability_manifest_id": {"type": "string", "format": "uuid"},
    "manifest_revision": {"const": 1},
    "budget_reservation_id": {"type": "string", "format": "uuid"},
    "budget_account_version": {"type": "integer", "minimum": 2},
    "approval_consumption_id": {"type": ["string", "null"], "format": "uuid"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "worker_id": {"type": "string"},
    "worker_version": {"type": "integer", "minimum": 1},
    "lease_id": {"type": "string", "format": "uuid"},
    "consumed_lease_version": {"type": "integer", "minimum": 1},
    "resulting_lease_version": {"type": "integer", "minimum": 2},
    "lease_generation": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "recovery_generation": {"type": "integer", "minimum": 1},
    "lease_state_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "purpose": {"const": "start_validation_task_coordination"},
    "consumed_at": {"type": "string", "format": "date-time"},
    "resulting_task_state": {"const": "running"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
