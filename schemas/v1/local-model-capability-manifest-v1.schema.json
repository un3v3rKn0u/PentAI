{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/local-model-capability-manifest-v1.schema.json",
  "title": "PentAI Local Model Capability Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "manifest_revision", "assessment_id", "plan_id", "plan_revision", "task_id", "task_revision", "task_type", "agent_id", "policy_bundle_id", "policy_hash", "configuration_snapshot_id", "configuration_snapshot_digest", "provider_id", "model_id", "allowed_purpose", "allowed_capability", "allowed_input_classifications", "limits", "issued_at", "expires_at", "issued_by", "delegation_allowed", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "manifest_revision": {"const": 1},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "format": "uuid"},
    "task_revision": {"type": "integer", "minimum": 1},
    "task_type": {"const": "validation"},
    "agent_id": {"type": "string", "pattern": "^agent://validation/[a-z0-9][a-z0-9._-]{0,63}$"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "configuration_snapshot_id": {"type": "string", "format": "uuid"},
    "configuration_snapshot_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "provider_id": {"const": "llama.cpp"},
    "model_id": {"const": "Qwen/Qwen2.5-Coder-3B-Instruct-GGUF:Q4_K_M"},
    "allowed_purpose": {"const": "propose_supervised_local_model_generation"},
    "allowed_capability": {"const": "ai.local.generate"},
    "allowed_input_classifications": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["public", "internal", "confidential", "restricted_redacted"]}},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_input_tokens", "maximum_output_tokens", "maximum_runtime_seconds"],
      "properties": {
        "maximum_input_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maximum_output_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maximum_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "issued_by": {"const": "pentai-core"},
    "delegation_allowed": {"const": false},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
