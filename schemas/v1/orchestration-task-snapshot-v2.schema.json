{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-task-snapshot-v2.schema.json",
  "title": "PentAI OrchestrationTaskSnapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "plan_id", "plan_revision", "plan_state", "task_id", "task_revision", "task_type", "task_state", "terminal_lineage", "observed_at", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "plan_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "plan_state": {"enum": ["active", "completed", "cancelled", "failed"]},
    "task_id": {"type": "string", "format": "uuid"},
    "task_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "task_type": {"enum": ["scope", "rules_of_engagement", "evidence", "validation", "reporting"]},
    "task_state": {"enum": ["blocked", "awaiting_human", "ready", "running", "cancelling", "cancelled", "succeeded", "failed", "dead_letter"]},
    "terminal_lineage": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["consumption_id", "consumption_digest", "terminal_decision_id", "terminal_decision_digest", "outcome", "reason_code"],
          "properties": {
            "consumption_id": {"type": "string", "format": "uuid"},
            "consumption_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "terminal_decision_id": {"type": "string", "format": "uuid"},
            "terminal_decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "outcome": {"const": "dead_letter_eligible"},
            "reason_code": {"const": "retry_ceiling_exhausted"}
          }
        }
      ]
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"task_state": {"const": "dead_letter"}}},
      "then": {"properties": {"terminal_lineage": {"type": "object"}}},
      "else": {"properties": {"terminal_lineage": {"type": "null"}}}
    }
  ]
}
