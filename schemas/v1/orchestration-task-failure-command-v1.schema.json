{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-task-failure-command-v1.schema.json",
  "title": "PentAI OrchestrationTaskFailureCommand v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "assessment_id", "plan_id", "expected_plan_revision", "task_id", "expected_task_revision", "agent_id", "capability_manifest_id", "manifest_revision", "budget_reservation_id", "budget_account_version", "approval_consumption_id", "lease_consumption_id", "lease_consumption_digest", "policy_bundle_id", "policy_hash", "worker_id", "expected_worker_version", "lease_generation", "fencing_token", "expected_recovery_generation", "checkpoint_id", "checkpoint_sequence", "checkpoint_digest", "failure_class", "purpose", "requested_at", "expires_at", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "command_id": {"type": "string", "format": "uuid"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "expected_plan_revision": {"type": "integer", "minimum": 2},
    "task_id": {"type": "string", "format": "uuid"},
    "expected_task_revision": {"type": "integer", "minimum": 2},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "capability_manifest_id": {"type": "string", "format": "uuid"},
    "manifest_revision": {"const": 1},
    "budget_reservation_id": {"type": "string", "format": "uuid"},
    "budget_account_version": {"type": "integer", "minimum": 2},
    "approval_consumption_id": {"type": ["string", "null"], "format": "uuid"},
    "lease_consumption_id": {"type": "string", "format": "uuid"},
    "lease_consumption_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "worker_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "expected_worker_version": {"type": "integer", "minimum": 1},
    "lease_generation": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "expected_recovery_generation": {"type": "integer", "minimum": 1},
    "checkpoint_id": {"type": ["string", "null"], "format": "uuid"},
    "checkpoint_sequence": {"type": ["integer", "null"], "minimum": 1, "maximum": 10000},
    "checkpoint_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "failure_class": {"enum": ["checkpoint_stalled", "coordination_timeout", "runtime_unavailable", "worker_process_failed"]},
    "purpose": {"const": "record_validation_task_failure"},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
