{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/ai-provider-registry-v1.schema.json",
  "title": "PentAI AI Provider Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "revision",
    "providers",
    "budget_ceilings",
    "remote_providers_enabled",
    "configured_at",
    "expires_at",
    "execution_enabled"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "provider_type",
          "models",
          "allowed_input_classifications",
          "state"
        ],
        "properties": {
          "provider_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
          },
          "provider_type": {"enum": ["approved_remote", "local_runtime"]},
          "models": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            }
          },
          "allowed_input_classifications": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "public",
                "internal",
                "confidential",
                "restricted_redacted",
                "restricted_raw_evidence",
                "secret"
              ]
            }
          },
          "state": {"enum": ["enabled", "disabled"]}
        }
      }
    },
    "budget_ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_tokens",
        "max_output_tokens",
        "max_requests",
        "max_cost_microusd",
        "max_runtime_seconds"
      ],
      "properties": {
        "max_input_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_requests": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_cost_microusd": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "remote_providers_enabled": {"type": "boolean"},
    "configured_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "execution_enabled": {"const": false}
  }
}
