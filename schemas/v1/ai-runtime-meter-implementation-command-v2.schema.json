{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/ai-runtime-meter-implementation-command-v2.schema.json",
  "title": "PentAI AI Runtime Meter Implementation Command v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "capability_id", "manifest_id", "manifest_revision", "manifest_digest", "manifest_registry_digest", "implementation_id", "implementation_version", "implementation_artifact_digest", "provider_types", "supported_dimensions", "capability_valid_from", "capability_expires_at", "requester", "authentication_context", "purpose", "requested_at", "expires_at", "production_enabled", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "command_id": {"type": "string", "format": "uuid"},
    "capability_id": {"type": "string", "format": "uuid"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "manifest_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "manifest_registry_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "implementation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "implementation_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "implementation_artifact_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "provider_types": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["approved_remote", "local_runtime"]}},
    "supported_dimensions": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["input_tokens", "output_tokens", "requests", "cost_microusd", "runtime_seconds"]}},
    "capability_valid_from": {"type": "string", "format": "date-time"},
    "capability_expires_at": {"type": "string", "format": "date-time"},
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "actor_id", "session_id"],
      "properties": {
        "actor_type": {"const": "human"},
        "actor_id": {"enum": ["local-desktop-session", "test-session"]},
        "session_id": {"type": "string", "format": "uuid"}
      }
    },
    "authentication_context": {"const": "local_core_authenticated_session"},
    "purpose": {"const": "record_manifest_verified_runtime_meter_implementation"},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "production_enabled": {"const": false},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
