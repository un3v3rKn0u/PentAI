{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/ai-provider-configuration-snapshot-receipt-v1.schema.json",
  "title": "PentAI AI Provider Configuration Snapshot Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "snapshot_digest", "configuration_id", "configuration_hash", "registry_id", "registry_revision", "provider_type", "provider_id", "model_id", "state", "meter_binding_enabled", "recorded_at", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"type": "string", "format": "uuid"},
    "snapshot_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "configuration_id": {"type": "string", "format": "uuid"},
    "configuration_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "registry_id": {"type": "string", "format": "uuid"},
    "registry_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "provider_type": {"enum": ["approved_remote", "local_runtime"]},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"},
    "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "state": {"const": "inactive"},
    "meter_binding_enabled": {"const": false},
    "recorded_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
