{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-task-budget-request-v1.schema.json",
  "title": "PentAI OrchestrationTaskBudgetRequest v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "account_id", "expected_account_version", "assessment_id", "plan_id", "expected_plan_revision", "task_id", "expected_task_revision", "agent_id", "capability_manifest_id", "expected_manifest_revision", "policy_bundle_id", "policy_hash", "purpose", "amounts", "requested_at", "expires_at", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "format": "uuid"},
    "account_id": {"type": "string", "format": "uuid"},
    "expected_account_version": {"type": "integer", "minimum": 1, "maximum": 9223372036854775806},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "expected_plan_revision": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "format": "uuid"},
    "expected_task_revision": {"type": "integer", "minimum": 1},
    "agent_id": {"type": "string", "pattern": "^agent://validation/[a-z0-9][a-z0-9._-]{0,63}$"},
    "capability_manifest_id": {"type": "string", "format": "uuid"},
    "expected_manifest_revision": {"const": 1},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "purpose": {"const": "reserve_validation_task_budget"},
    "amounts": {"$ref": "#/$defs/amounts"},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  },
  "$defs": {"amounts": {
    "type": "object", "additionalProperties": false,
    "required": ["input_tokens", "output_tokens", "requests", "cost_microusd", "runtime_seconds", "retries"],
    "properties": {
      "input_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000},
      "output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000},
      "requests": {"type": "integer", "minimum": 0, "maximum": 10000},
      "cost_microusd": {"type": "integer", "minimum": 0, "maximum": 1000000000},
      "runtime_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
      "retries": {"type": "integer", "minimum": 0, "maximum": 100}
    }
  }}
}
