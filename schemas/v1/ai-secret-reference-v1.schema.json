{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/ai-secret-reference-v1.schema.json",
  "title": "PentAI AI Secret Reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "secret_ref",
    "configuration_id",
    "provider_id",
    "purpose",
    "state",
    "created_at",
    "expires_at",
    "revoked_at",
    "resolution_enabled"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "secret_ref": {
      "type": "string",
      "pattern": "^secretref://provider/[a-z0-9][a-z0-9.-]{0,63}/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "configuration_id": {"type": "string", "format": "uuid"},
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "purpose": {"const": "provider_authentication"},
    "state": {"enum": ["active", "revoked"]},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revoked_at": {
      "oneOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "resolution_enabled": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "active"}}},
      "then": {"properties": {"revoked_at": {"const": null}}},
      "else": {"properties": {"revoked_at": {"type": "string", "format": "date-time"}}}
    }
  ]
}
