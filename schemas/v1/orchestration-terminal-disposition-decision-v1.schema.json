{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-terminal-disposition-decision-v1.schema.json",
  "title": "PentAI OrchestrationTerminalDispositionDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "command_id", "command_digest", "assessment_id", "plan_id", "plan_revision", "task_id", "task_revision", "failed_attempt_id", "failed_attempt_digest", "failure_id", "failure_receipt_digest", "failure_class", "retry_policy_id", "retry_policy_digest", "attempt_number", "maximum_attempts", "additional_attempts_permitted", "outcome", "reason_code", "dead_letter_transition_enabled", "queue_enabled", "operator_review_enabled", "purpose", "decided_at", "decision_digest", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "decision_id": {"type": "string", "format": "uuid"},
    "command_id": {"type": "string", "format": "uuid"},
    "command_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "plan_revision": {"type": "integer", "minimum": 8},
    "task_id": {"type": "string", "format": "uuid"},
    "task_revision": {"type": "integer", "minimum": 8},
    "failed_attempt_id": {"type": "string", "format": "uuid"},
    "failed_attempt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "failure_id": {"type": "string", "format": "uuid"},
    "failure_receipt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "failure_class": {"enum": ["checkpoint_stalled", "coordination_timeout", "runtime_unavailable", "worker_process_failed"]},
    "retry_policy_id": {"type": "string", "format": "uuid"},
    "retry_policy_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "attempt_number": {"const": 3},
    "maximum_attempts": {"const": 3},
    "additional_attempts_permitted": {"const": 0},
    "outcome": {"const": "dead_letter_eligible"},
    "reason_code": {"const": "retry_ceiling_exhausted"},
    "dead_letter_transition_enabled": {"const": false},
    "queue_enabled": {"const": false},
    "operator_review_enabled": {"const": false},
    "purpose": {"const": "decide_attempt_three_terminal_disposition"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
