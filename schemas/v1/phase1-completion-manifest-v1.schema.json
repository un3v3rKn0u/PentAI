{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/phase1-completion-manifest-v1.schema.json",
  "title": "PentAI Phase 1 Completion Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "assurance_scope", "requirements"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "phase": {"const": "phase-1"},
    "assurance_scope": {"const": "local-development-owned-fixtures"},
    "requirements": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status", "invariants", "implementation", "tests", "review"],
        "properties": {
          "id": {"type": "string", "pattern": "^P1-[A-Z]+-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "status": {"const": "implemented"},
          "invariants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^INV-[A-Z]+-[0-9]{3}$"}
          },
          "implementation": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(services|packages|apps|tools|migrations|schemas)/.+"}
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^tests/test_.+\\.py$"}
          },
          "review": {"type": "string", "pattern": "^docs/security/.+\\.md$"},
          "hosted_check": {"type": "string", "pattern": "^\\.github/workflows/.+\\.yml$"}
        }
      }
    }
  }
}
