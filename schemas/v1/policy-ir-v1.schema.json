{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/policy-ir-v1.schema.json",
  "title": "PentAI Policy IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "engagement_id", "manifest_hash", "compiler", "validity", "asset_rules", "capability_rules", "budgets", "network_constraints", "approval_requirements", "default_effect", "content_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "format": "uuid"},
    "engagement_id": {"type": "string", "format": "uuid"},
    "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "canonicalization_version"],
      "properties": {
        "name": {"const": "pentai-policy-compiler"},
        "version": {"type": "string"},
        "canonicalization_version": {"const": "1.0.0"}
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not_before", "not_after", "revocation_epoch"],
      "properties": {
        "not_before": {"type": "string", "format": "date-time"},
        "not_after": {"type": "string", "format": "date-time"},
        "revocation_epoch": {"type": "integer", "minimum": 0}
      }
    },
    "asset_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "effect", "asset_type", "matcher", "specificity", "source_references"],
        "properties": {
          "rule_id": {"type": "string", "format": "uuid"},
          "effect": {"enum": ["allow", "deny"]},
          "asset_type": {"enum": ["domain", "wildcard_domain", "url", "ipv4", "ipv6", "cidr"]},
          "matcher": {"type": "object"},
          "specificity": {"type": "integer", "minimum": 0},
          "allowed_ports": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}, "uniqueItems": true},
          "allowed_paths": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "uniqueItems": true},
          "source_references": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "capability_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "capability", "effect", "source_references"],
        "properties": {
          "rule_id": {"type": "string", "format": "uuid"},
          "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
          "effect": {"enum": ["allow", "deny", "conditional"]},
          "applicable_asset_rule_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
          "conditions": {"type": "array", "items": {"type": "object"}},
          "source_references": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_rps", "per_host_rps", "burst", "concurrent_connections", "maximum_total_requests", "maximum_runtime_seconds", "maximum_response_bytes"],
      "properties": {
        "global_rps": {"type": "number", "exclusiveMinimum": 0},
        "per_host_rps": {"type": "number", "exclusiveMinimum": 0},
        "burst": {"type": "integer", "minimum": 1},
        "concurrent_connections": {"type": "integer", "minimum": 1},
        "maximum_total_requests": {"type": "integer", "minimum": 1},
        "maximum_runtime_seconds": {"type": "integer", "minimum": 1},
        "maximum_request_body_bytes": {"type": "integer", "minimum": 0},
        "maximum_response_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "network_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_profile_id", "registered_source_ipv4", "registered_source_ipv6", "ipv6_mode", "dns_mode", "pause_on_identity_change"],
      "properties": {
        "route_profile_id": {"type": "string", "minLength": 1},
        "registered_source_ipv4": {"type": "array", "items": {"type": "string", "format": "ipv4"}, "uniqueItems": true},
        "registered_source_ipv6": {"type": "array", "items": {"type": "string", "format": "ipv6"}, "uniqueItems": true},
        "ipv6_mode": {"enum": ["disabled", "approved_only"]},
        "dns_mode": {"enum": ["tunnel_resolver", "approved_resolver"]},
        "pause_on_identity_change": {"const": true}
      }
    },
    "approval_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approval_type", "capability", "maximum_ttl_seconds"],
        "properties": {
          "approval_type": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "maximum_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
        }
      }
    },
    "account_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "approved_account_references"],
      "properties": {
        "mode": {"enum": ["unauthenticated_only", "approved_test_accounts"]},
        "approved_account_references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"}}
      }
    },
    "default_effect": {"const": "deny"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"enum": ["Ed25519"]},
        "key_id": {"type": "string"},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
