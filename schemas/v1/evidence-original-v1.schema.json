{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/evidence-original-v1.schema.json",
  "title": "PentAI EvidenceOriginal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "workflow_id", "engagement_id", "policy_bundle_id", "execution_trace_id", "evidence_kind", "sha256", "storage_ref", "size_bytes", "media_type", "classification", "encryption_version", "created_by", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evidence_id": {"type": "string", "format": "uuid"},
    "workflow_id": {"type": "string", "format": "uuid"},
    "engagement_id": {"type": "string", "format": "uuid"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "execution_trace_id": {"type": ["string", "null"], "format": "uuid"},
    "evidence_kind": {"enum": ["note", "http_metadata", "response_excerpt", "screenshot", "imported_file", "tool_output"]},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "storage_ref": {"type": "string", "pattern": "^encrypted-evidence:v1:[a-f0-9]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
    "media_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]{0,63}/[a-z0-9][a-z0-9.+-]{0,63}$"},
    "classification": {"enum": ["internal", "restricted"]},
    "encryption_version": {"const": "aes-256-gcm-hkdf-v1"},
    "created_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
