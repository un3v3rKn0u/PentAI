{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-retry-decision-v1.schema.json",
  "title": "PentAI OrchestrationRetryDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "command_id", "command_digest", "assessment_id", "plan_id", "plan_revision", "task_id", "task_revision", "attempt_id", "attempt_digest", "failure_id", "failure_receipt_digest", "failure_class", "checkpoint_id", "checkpoint_digest", "lease_consumption_id", "worker_id", "worker_version", "lease_generation", "fencing_token", "recovery_generation", "capability_manifest_id", "manifest_revision", "budget_reservation_id", "budget_account_version", "approval_consumption_id", "policy_bundle_id", "policy_hash", "retry_policy_id", "retry_policy_revision", "retry_policy_digest", "outcome", "reason_code", "current_attempt_number", "proposed_attempt_number", "earliest_retry_at", "retry_units_consumed", "purpose", "decided_at", "expires_at", "decision_digest", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "decision_id": {"type": "string", "format": "uuid"},
    "command_id": {"type": "string", "format": "uuid"},
    "command_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "plan_revision": {"type": "integer", "minimum": 3},
    "task_id": {"type": "string", "format": "uuid"},
    "task_revision": {"type": "integer", "minimum": 3},
    "attempt_id": {"type": "string", "format": "uuid"},
    "attempt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "failure_id": {"type": "string", "format": "uuid"},
    "failure_receipt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "failure_class": {"enum": ["checkpoint_stalled", "coordination_timeout", "runtime_unavailable", "worker_process_failed"]},
    "checkpoint_id": {"type": ["string", "null"], "format": "uuid"},
    "checkpoint_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "lease_consumption_id": {"type": "string", "format": "uuid"},
    "worker_id": {"type": "string"},
    "worker_version": {"type": "integer", "minimum": 1},
    "lease_generation": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "recovery_generation": {"type": "integer", "minimum": 1},
    "capability_manifest_id": {"type": "string", "format": "uuid"},
    "manifest_revision": {"const": 1},
    "budget_reservation_id": {"type": "string", "format": "uuid"},
    "budget_account_version": {"type": "integer", "minimum": 2},
    "approval_consumption_id": {"type": ["string", "null"], "format": "uuid"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retry_policy_id": {"type": "string", "format": "uuid"},
    "retry_policy_revision": {"const": 1},
    "retry_policy_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "outcome": {"enum": ["eligible", "denied"]},
    "reason_code": {"enum": ["RETRY_ELIGIBLE_TRANSIENT_FAILURE", "RETRY_DENIED_MANUAL_REVIEW_REQUIRED", "RETRY_DENIED_CAPACITY_UNAVAILABLE", "RETRY_DENIED_ATTEMPT_LIMIT"]},
    "current_attempt_number": {"const": 1},
    "proposed_attempt_number": {"const": 2},
    "earliest_retry_at": {"type": ["string", "null"], "format": "date-time"},
    "retry_units_consumed": {"const": 0},
    "purpose": {"const": "evaluate_validation_retry"},
    "decided_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "eligible"}}}, "then": {"properties": {"reason_code": {"const": "RETRY_ELIGIBLE_TRANSIENT_FAILURE"}, "earliest_retry_at": {"type": "string", "format": "date-time"}}}},
    {"if": {"properties": {"outcome": {"const": "denied"}}}, "then": {"properties": {"earliest_retry_at": {"const": null}}}}
  ]
}
