{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/finding-v1.schema.json",
  "title": "PentAI Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "workflow_id", "engagement_id", "policy_bundle_id", "state", "version", "title", "severity", "cvss", "cwe", "confidence", "validation_status", "duplicate_status", "duplicate_of", "affected_asset_rule_ids", "evidence_ids", "reproduction", "impact", "remediation", "references", "fingerprint", "created_by", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "finding_id": {"type": "string", "format": "uuid"},
    "workflow_id": {"type": "string", "format": "uuid"},
    "engagement_id": {"type": "string", "format": "uuid"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "state": {"enum": ["candidate", "scope_reviewed", "duplicate_reviewed", "validated", "report_ready", "closed", "rejected"]},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "severity": {"enum": ["informational", "low", "medium", "high", "critical"]},
    "cvss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "vector", "base_score"],
      "properties": {
        "version": {"const": "3.1"},
        "vector": {"type": "string", "pattern": "^CVSS:3\\.1/AV:[NALP]/AC:[LH]/PR:[NLH]/UI:[NR]/S:[UC]/C:[NLH]/I:[NLH]/A:[NLH]$"},
        "base_score": {"type": "number", "minimum": 0, "maximum": 10, "multipleOf": 0.1}
      }
    },
    "cwe": {"type": "string", "pattern": "^CWE-[1-9][0-9]{0,4}$"},
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "validation_status": {"enum": ["unverified", "confirmed", "not_reproduced", "false_positive", "needs_retest"]},
    "duplicate_status": {"enum": ["pending", "clear", "duplicate"]},
    "duplicate_of": {"type": ["string", "null"], "format": "uuid"},
    "affected_asset_rule_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "reproduction": {"type": "string", "minLength": 1, "maxLength": 20000},
    "impact": {"type": "string", "minLength": 1, "maxLength": 10000},
    "remediation": {"type": "string", "minLength": 1, "maxLength": 10000},
    "references": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "format": "uri", "maxLength": 2048}},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"duplicate_status": {"const": "duplicate"}}},
      "then": {"properties": {"duplicate_of": {"type": "string", "format": "uuid"}}},
      "else": {"properties": {"duplicate_of": {"type": "null"}}}
    }
  ]
}
