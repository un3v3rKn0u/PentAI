{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-task-lease-acquire-v1.schema.json",
  "title": "PentAI OrchestrationTaskLeaseAcquire v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "assessment_id", "plan_id", "expected_plan_revision", "task_id", "expected_task_revision", "agent_id", "capability_manifest_id", "manifest_revision", "budget_reservation_id", "budget_account_version", "approval_consumption_id", "policy_bundle_id", "policy_hash", "worker_id", "expected_worker_version", "expected_recovery_generation", "lease_seconds", "requested_at", "purpose", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "format": "uuid"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "expected_plan_revision": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "format": "uuid"},
    "expected_task_revision": {"type": "integer", "minimum": 1},
    "agent_id": {"type": "string", "pattern": "^agent://validation/[a-z0-9][a-z0-9._-]{0,63}$"},
    "capability_manifest_id": {"type": "string", "format": "uuid"},
    "manifest_revision": {"const": 1},
    "budget_reservation_id": {"type": "string", "format": "uuid"},
    "budget_account_version": {"type": "integer", "minimum": 2},
    "approval_consumption_id": {"type": ["string", "null"], "format": "uuid"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "worker_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "expected_worker_version": {"type": "integer", "minimum": 1},
    "expected_recovery_generation": {"type": "integer", "minimum": 1},
    "lease_seconds": {"type": "integer", "minimum": 5, "maximum": 60},
    "requested_at": {"type": "string", "format": "date-time"},
    "purpose": {"const": "coordinate_validation_task"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
