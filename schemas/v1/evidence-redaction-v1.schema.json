{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/evidence-redaction-v1.schema.json",
  "title": "PentAI EvidenceRedaction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "derivative_id", "parent_evidence_id", "workflow_id", "engagement_id", "policy_bundle_id", "derivative_kind", "source_sha256", "sha256", "storage_ref", "size_bytes", "media_type", "classification", "classification_confirmed_by", "classification_confirmed_at", "encryption_version", "offset_unit", "redactions", "created_by", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "derivative_id": {"type": "string", "format": "uuid"},
    "parent_evidence_id": {"type": "string", "format": "uuid"},
    "workflow_id": {"type": "string", "format": "uuid"},
    "engagement_id": {"type": "string", "format": "uuid"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "derivative_kind": {"const": "redaction"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "storage_ref": {"type": "string", "pattern": "^encrypted-evidence:v1:[a-f0-9]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
    "media_type": {"const": "text/plain"},
    "classification": {"enum": ["public", "internal"]},
    "classification_confirmed_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "classification_confirmed_at": {"type": "string", "format": "date-time"},
    "encryption_version": {"const": "aes-256-gcm-hkdf-v1"},
    "offset_unit": {"const": "unicode_codepoints"},
    "redactions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "reason", "replacement"],
        "properties": {
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "reason": {"enum": ["secret", "personal_data", "irrelevant", "operator_selected"]},
          "replacement": {"const": "[REDACTED]"}
        }
      }
    },
    "created_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
