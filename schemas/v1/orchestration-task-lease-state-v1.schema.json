{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-task-lease-state-v1.schema.json",
  "title": "PentAI OrchestrationTaskLeaseState v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "lease_id", "request_id", "assessment_id", "plan_id", "plan_revision", "task_id", "task_revision", "task_type", "agent_id", "capability_manifest_id", "manifest_revision", "budget_reservation_id", "budget_account_version", "approval_consumption_id", "policy_bundle_id", "policy_hash", "worker_id", "worker_version", "recovery_generation", "lease_generation", "fencing_token", "lease_version", "state", "acquired_at", "expires_at", "maximum_expires_at", "released_at", "release_reason", "purpose", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "lease_id": {"type": "string", "format": "uuid"},
    "request_id": {"type": "string", "format": "uuid"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "format": "uuid"},
    "task_revision": {"type": "integer", "minimum": 1},
    "task_type": {"const": "validation"},
    "agent_id": {"type": "string"},
    "capability_manifest_id": {"type": "string", "format": "uuid"},
    "manifest_revision": {"const": 1},
    "budget_reservation_id": {"type": "string", "format": "uuid"},
    "budget_account_version": {"type": "integer", "minimum": 2},
    "approval_consumption_id": {"type": ["string", "null"], "format": "uuid"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "worker_id": {"type": "string"},
    "worker_version": {"type": "integer", "minimum": 1},
    "recovery_generation": {"type": "integer", "minimum": 1},
    "lease_generation": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "lease_version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["active", "released", "expired", "invalidated"]},
    "acquired_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "maximum_expires_at": {"type": "string", "format": "date-time"},
    "released_at": {"type": ["string", "null"], "format": "date-time"},
    "release_reason": {"enum": ["none", "released", "expired", "cancelled", "recovery", "worker_ineligible", "security_state"]},
    "purpose": {"const": "coordinate_validation_task"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
