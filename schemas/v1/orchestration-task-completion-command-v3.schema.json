{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-task-completion-command-v3.schema.json",
  "title": "PentAI AttemptThreeTaskCompletionCommand v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "assessment_id", "plan_id", "expected_plan_revision", "task_id", "expected_task_revision", "agent_id", "capability_manifest_id", "capability_manifest_digest", "manifest_revision", "budget_reservation_id", "budget_request_digest", "budget_account_version", "retry_policy_id", "retry_policy_digest", "retry_activation_id", "retry_activation_digest", "retry_schedule_id", "retry_schedule_digest", "retry_attempt_id", "retry_attempt_digest", "attempt_number", "prior_retry_budget_consumption_id", "retry_budget_consumption_id", "approval_consumption_id", "lease_consumption_id", "lease_consumption_digest", "policy_bundle_id", "policy_hash", "worker_id", "expected_worker_version", "lease_id", "lease_generation", "fencing_token", "expected_recovery_generation", "checkpoint_id", "checkpoint_sequence", "checkpoint_digest", "purpose", "requested_at", "expires_at", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "command_id": {"type": "string", "format": "uuid"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "expected_plan_revision": {"type": "integer", "minimum": 7, "maximum": 2147483646},
    "task_id": {"type": "string", "format": "uuid"},
    "expected_task_revision": {"type": "integer", "minimum": 7, "maximum": 2147483646},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "capability_manifest_id": {"type": "string", "format": "uuid"},
    "capability_manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "manifest_revision": {"const": 1},
    "budget_reservation_id": {"type": "string", "format": "uuid"},
    "budget_request_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "budget_account_version": {"type": "integer", "minimum": 2, "maximum": 2147483647},
    "retry_policy_id": {"type": "string", "format": "uuid"},
    "retry_policy_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "retry_activation_id": {"type": "string", "format": "uuid"},
    "retry_activation_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "retry_schedule_id": {"type": "string", "format": "uuid"},
    "retry_schedule_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "retry_attempt_id": {"type": "string", "format": "uuid"},
    "retry_attempt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "attempt_number": {"const": 3},
    "prior_retry_budget_consumption_id": {"type": "string", "format": "uuid"},
    "retry_budget_consumption_id": {"type": "string", "format": "uuid"},
    "approval_consumption_id": {"type": ["string", "null"], "format": "uuid"},
    "lease_consumption_id": {"type": "string", "format": "uuid"},
    "lease_consumption_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "worker_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "expected_worker_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "lease_id": {"type": "string", "format": "uuid"},
    "lease_generation": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "fencing_token": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "expected_recovery_generation": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "checkpoint_id": {"type": ["string", "null"], "format": "uuid"},
    "checkpoint_sequence": {"type": ["integer", "null"], "minimum": 1, "maximum": 10000},
    "checkpoint_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "purpose": {"const": "consume_attempt_three_validation_task_completion"},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"checkpoint_id": {"type": "null"}}},
      "then": {"properties": {"checkpoint_sequence": {"type": "null"}, "checkpoint_digest": {"type": "null"}}},
      "else": {"properties": {"checkpoint_sequence": {"type": "integer"}, "checkpoint_digest": {"type": "string"}}}
    }
  ]
}
