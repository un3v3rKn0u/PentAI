{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-task-checkpoint-receipt-v1.schema.json",
  "title": "PentAI OrchestrationTaskCheckpointReceipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "checkpoint_id", "command_id", "command_digest", "assessment_id", "plan_id", "plan_revision", "task_id", "task_revision", "agent_id", "capability_manifest_id", "manifest_revision", "budget_reservation_id", "budget_account_version", "approval_consumption_id", "lease_consumption_id", "lease_consumption_digest", "policy_bundle_id", "policy_hash", "worker_id", "worker_version", "lease_generation", "fencing_token", "recovery_generation", "sequence", "previous_checkpoint_digest", "progress_percent", "status", "purpose", "created_at", "checkpoint_digest", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "checkpoint_id": {"type": "string", "format": "uuid"}, "command_id": {"type": "string", "format": "uuid"},
    "command_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"}, "plan_revision": {"type": "integer", "minimum": 2}, "task_id": {"type": "string", "format": "uuid"},
    "task_revision": {"type": "integer", "minimum": 2}, "agent_id": {"type": "string"}, "capability_manifest_id": {"type": "string", "format": "uuid"},
    "manifest_revision": {"const": 1}, "budget_reservation_id": {"type": "string", "format": "uuid"}, "budget_account_version": {"type": "integer", "minimum": 2},
    "approval_consumption_id": {"type": ["string", "null"], "format": "uuid"}, "lease_consumption_id": {"type": "string", "format": "uuid"},
    "lease_consumption_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "worker_id": {"type": "string"}, "worker_version": {"type": "integer", "minimum": 1},
    "lease_generation": {"type": "integer", "minimum": 1}, "fencing_token": {"type": "integer", "minimum": 1}, "recovery_generation": {"type": "integer", "minimum": 1},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 10000}, "previous_checkpoint_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "progress_percent": {"type": "integer", "minimum": 0, "maximum": 99}, "status": {"enum": ["started", "in_progress", "awaiting_input"]},
    "purpose": {"const": "record_validation_progress"}, "created_at": {"type": "string", "format": "date-time"},
    "checkpoint_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "authority": {"const": "none"}, "execution_enabled": {"const": false}
  }
}
