{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/ai-runtime-meter-implementation-receipt-v1.schema.json",
  "title": "PentAI AI Runtime Meter Implementation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability_id", "capability_digest", "implementation_id", "implementation_version", "provider_types", "supported_dimensions", "recorded_at", "expires_at", "state", "identity_binding_enabled", "attestation_enabled", "measurement_enabled", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "capability_id": {"type": "string", "format": "uuid"},
    "capability_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "implementation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "implementation_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "provider_types": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["approved_remote", "local_runtime"]}},
    "supported_dimensions": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["input_tokens", "output_tokens", "requests", "cost_microusd", "runtime_seconds"]}},
    "recorded_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "state": {"const": "inactive"},
    "identity_binding_enabled": {"const": false},
    "attestation_enabled": {"const": false},
    "measurement_enabled": {"const": false},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
