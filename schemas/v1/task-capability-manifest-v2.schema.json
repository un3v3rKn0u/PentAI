{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/task-capability-manifest-v2.schema.json",
  "title": "PentAI TaskCapabilityManifest v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "manifest_revision", "assessment_id", "plan_id", "plan_revision", "task_id", "task_revision", "task_state", "task_type", "agent_id", "policy_bundle_id", "policy_hash", "allowed_purposes", "allowed_capabilities", "limits", "issued_at", "expires_at", "issued_by", "delegation_allowed", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "manifest_revision": {"const": 1},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "format": "uuid"},
    "task_revision": {"type": "integer", "minimum": 1},
    "task_state": {"enum": ["ready", "running"]},
    "task_type": {"const": "validation"},
    "agent_id": {"type": "string", "pattern": "^agent://validation/[a-z0-9][a-z0-9._-]{0,63}$"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "allowed_purposes": {"const": ["propose_supervised_http_validation"]},
    "allowed_capabilities": {"const": ["network.http.get"]},
    "limits": {"type": "object", "additionalProperties": false, "required": ["maximum_impact", "maximum_timeout_seconds", "maximum_response_bytes"], "properties": {"maximum_impact": {"enum": ["passive", "benign"]}, "maximum_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30}, "maximum_response_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}}},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "issued_by": {"const": "pentai-core"},
    "delegation_allowed": {"const": false},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
