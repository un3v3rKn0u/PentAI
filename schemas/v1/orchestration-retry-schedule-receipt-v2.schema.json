{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/orchestration-retry-schedule-receipt-v2.schema.json",
  "title": "PentAI OrchestrationRetryScheduleReceipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schedule_id", "command_id", "command_digest", "assessment_id", "plan_id", "plan_revision", "task_id", "task_revision", "attempt_id", "attempt_digest", "attempt_number", "prior_attempt_id", "prior_attempt_digest", "failure_id", "failure_receipt_digest", "checkpoint_id", "checkpoint_digest", "lease_consumption_id", "worker_id", "worker_version", "lease_generation", "fencing_token", "recovery_generation", "capability_manifest_id", "capability_manifest_digest", "manifest_revision", "lineage_budget_reservation_id", "budget_request_digest", "budget_account_id", "capacity_budget_reservation_id", "budget_account_version", "approval_consumption_id", "policy_bundle_id", "policy_hash", "retry_activation_id", "retry_activation_digest", "prior_retry_budget_consumption_id", "retry_policy_id", "retry_policy_revision", "retry_policy_digest", "eligibility_decision_id", "eligibility_decision_digest", "retry_budget_consumption_id", "retry_budget_consumption_digest", "schedule_revision", "schedule_state", "scheduled_for", "expires_at", "purpose", "registered_at", "schedule_digest", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "schedule_id": {"type": "string", "format": "uuid"},
    "command_id": {"type": "string", "format": "uuid"},
    "command_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "plan_revision": {"type": "integer", "minimum": 5},
    "task_id": {"type": "string", "format": "uuid"},
    "task_revision": {"type": "integer", "minimum": 5},
    "attempt_id": {"type": "string", "format": "uuid"},
    "attempt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "attempt_number": {"const": 3},
    "prior_attempt_id": {"type": "string", "format": "uuid"},
    "prior_attempt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "failure_id": {"type": "string", "format": "uuid"},
    "failure_receipt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "checkpoint_id": {"type": ["string", "null"], "format": "uuid"},
    "checkpoint_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "lease_consumption_id": {"type": "string", "format": "uuid"},
    "worker_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "worker_version": {"type": "integer", "minimum": 1},
    "lease_generation": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "recovery_generation": {"type": "integer", "minimum": 1},
    "capability_manifest_id": {"type": "string", "format": "uuid"},
    "capability_manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "manifest_revision": {"const": 1},
    "lineage_budget_reservation_id": {"type": "string", "format": "uuid"},
    "budget_request_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "budget_account_id": {"type": "string", "format": "uuid"},
    "capacity_budget_reservation_id": {"type": "string", "format": "uuid"},
    "budget_account_version": {"type": "integer", "minimum": 4},
    "approval_consumption_id": {"type": ["string", "null"], "format": "uuid"},
    "policy_bundle_id": {"type": "string", "format": "uuid"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retry_activation_id": {"type": "string", "format": "uuid"},
    "retry_activation_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "prior_retry_budget_consumption_id": {"type": "string", "format": "uuid"},
    "retry_policy_id": {"type": "string", "format": "uuid"},
    "retry_policy_revision": {"const": 1},
    "retry_policy_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "eligibility_decision_id": {"type": "string", "format": "uuid"},
    "eligibility_decision_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "retry_budget_consumption_id": {"type": "string", "format": "uuid"},
    "retry_budget_consumption_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "schedule_revision": {"const": 1},
    "schedule_state": {"const": "registered"},
    "scheduled_for": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "purpose": {"const": "register_validation_retry_schedule_three"},
    "registered_at": {"type": "string", "format": "date-time"},
    "schedule_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
