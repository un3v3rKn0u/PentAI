{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/ai-budget-reservation-request-v1.schema.json",
  "title": "PentAI AI Budget Reservation Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "configuration_id", "registry_id", "registry_revision", "idempotency_key", "expected_ledger_version", "amounts", "requested_at", "expires_at", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "configuration_id": {"type": "string", "format": "uuid"},
    "registry_id": {"type": "string", "format": "uuid"},
    "registry_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{15,127}$"},
    "expected_ledger_version": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "amounts": {"$ref": "#/$defs/amounts"},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "execution_enabled": {"const": false}
  },
  "$defs": {
    "amounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "requests", "cost_microusd", "runtime_seconds"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "requests": {"type": "integer", "minimum": 0, "maximum": 10000},
        "cost_microusd": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "runtime_seconds": {"type": "integer", "minimum": 0, "maximum": 86400}
      }
    }
  }
}
