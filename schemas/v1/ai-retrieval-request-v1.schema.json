{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/ai-retrieval-request-v1.schema.json",
  "title": "PentAI AI Retrieval Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "assessment_id", "subject_id", "purpose", "policy_id", "policy_version", "expected_catalog_version", "query_sha256", "allowed_origins", "allowed_classifications", "result_limit", "requested_at", "expires_at", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "format": "uuid"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "subject_id": {"type": "string", "pattern": "^subject://(human|agent|service)/[a-z0-9][a-z0-9._-]{0,63}$"},
    "purpose": {"enum": ["scope_analysis", "roe_analysis", "evidence_summary", "validation_support", "reporting_support"]},
    "policy_id": {"type": "string", "format": "uuid"},
    "policy_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "expected_catalog_version": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "query_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "allowed_origins": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["program_page", "retrieved_document", "target_content", "tool_output", "evidence_derivative", "plugin_message", "model_output"]}},
    "allowed_classifications": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["public", "internal", "confidential", "restricted_redacted"]}},
    "result_limit": {"type": "integer", "minimum": 1, "maximum": 32},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
