{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pentai.local/v1/ai-retrieval-policy-v1.schema.json",
  "title": "PentAI AI Retrieval Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_version", "assessment_id", "permissions", "issued_at", "expires_at", "authority", "execution_enabled"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "format": "uuid"},
    "policy_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "assessment_id": {"type": "string", "format": "uuid"},
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_id", "purposes", "allowed_origins", "allowed_classifications", "max_results"],
        "properties": {
          "subject_id": {"type": "string", "pattern": "^subject://(human|agent|service)/[a-z0-9][a-z0-9._-]{0,63}$"},
          "purposes": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["scope_analysis", "roe_analysis", "evidence_summary", "validation_support", "reporting_support"]}},
          "allowed_origins": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["program_page", "retrieved_document", "target_content", "tool_output", "evidence_derivative", "plugin_message", "model_output"]}},
          "allowed_classifications": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["public", "internal", "confidential", "restricted_redacted"]}},
          "max_results": {"type": "integer", "minimum": 1, "maximum": 32}
        }
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "none"},
    "execution_enabled": {"const": false}
  }
}
